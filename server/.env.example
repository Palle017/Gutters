GUTTERS_BIND_HOST=127.0.0.1
GUTTERS_PORT=18965
GUTTERS_DB_PATH=/var/lib/gutters/gutters.sqlite3
# Set the eventual dedicated public HTTPS API origin after routing is configured.
# Loopback-only preparation can use http://127.0.0.1:18965 instead.
GUTTERS_PUBLIC_ORIGIN=http://127.0.0.1:18965
GUTTERS_ALLOWED_ORIGINS=https://palle017.github.io,http://127.0.0.1:18964
# Provision a new random 32-byte base64url owner key outside source control.
GUTTERS_OWNER_TOKEN=
# Enable only behind the dedicated proxy that overwrites X-Real-IP.
GUTTERS_TRUST_PROXY=false
# Email alerts are opt-in. Use a separate verified sender/recipient and send-only key.
GUTTERS_EMAIL_ENABLED=false
GUTTERS_EMAIL_FROM=
GUTTERS_EMAIL_TO=
GUTTERS_RESEND_API_KEY=
# Meta intake stays off until Raj enables it. Dry-run stores replies and does not call Graph.
# See docs/META-INTAKE.md. Do not commit tokens.
META_INTAKE_ENABLED=0
META_VERIFY_TOKEN=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_SEND_MODE=dry-run
# Optional path outside the release directory, for example /etc/gutters/estimate-availability.json
# META_AVAILABILITY_PATH=
# META_GRAPH_VERSION=v21.0
# Optional later. Leave disabled. OpenAI-compatible chat completions.
# META_LLM_ENABLED=0
# META_LLM_BASE_URL=
# META_LLM_API_KEY=
# META_LLM_MODEL=
